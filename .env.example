# ---------------------------------------------------------------------------
# Chat profiles
# ---------------------------------------------------------------------------
CHAT__DEFAULT_PROFILE=default

CHAT__PROFILES__DEFAULT__PROVIDER=ollama
CHAT__PROFILES__DEFAULT__MODEL=gemma4:e2b

CHAT__PROFILES__ASR__PROVIDER=ollama
CHAT__PROFILES__ASR__MODEL=gemma4:e2b

CHAT__PROFILES__ASR_V2__PROVIDER=ollama
CHAT__PROFILES__ASR_V2__MODEL=gemma4:e4b

# Optional per-profile defaults
# CHAT__PROFILES__DEFAULT__TEMPERATURE=0
# CHAT__PROFILES__DEFAULT__MAX_TOKENS=512

# ---------------------------------------------------------------------------
# Embedding profiles
# ---------------------------------------------------------------------------
EMBEDDINGS__DEFAULT_PROFILE=default
EMBEDDINGS__PROFILES__DEFAULT__PROVIDER=ollama
EMBEDDINGS__PROFILES__DEFAULT__MODEL=nomic-embed-text

EMBEDDINGS__PROFILES__ASR__PROVIDER=ollama
EMBEDDINGS__PROFILES__ASR__MODEL=nomic-embed-text

EMBEDDINGS__PROFILES__ASR_V2__PROVIDER=ollama
EMBEDDINGS__PROFILES__ASR_V2__MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Provider settings
# ---------------------------------------------------------------------------
PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434

PROVIDERS__OPENAI__API_KEY=
# PROVIDERS__OPENAI__BASE_URL=
# PROVIDERS__OPENAI__ORGANIZATION=

PROVIDERS__OPENROUTER__API_KEY=
PROVIDERS__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
# PROVIDERS__OPENROUTER__SITE_URL=https://example.com
# PROVIDERS__OPENROUTER__SITE_NAME=My App

PROVIDERS__AZURE_OPENAI__API_KEY=
PROVIDERS__AZURE_OPENAI__ENDPOINT=
PROVIDERS__AZURE_OPENAI__API_VERSION=2024-10-21

# Example Azure chat profile:
# CHAT__PROFILES__AZURE__PROVIDER=azure_openai
# CHAT__PROFILES__AZURE__MODEL=my-chat-deployment

# ---------------------------------------------------------------------------
# Search + tracing
# ---------------------------------------------------------------------------
SEARCH__TAVILY_API_KEY=

TRACING__API_KEY=
# TRACING__ENABLED=true
# TRACING__PROJECT=test-langchain
# TRACING__ENDPOINT=

# ---------------------------------------------------------------------------
# Legacy flat env vars still supported during migration
# ---------------------------------------------------------------------------
# OLLAMA_MODEL=gemma4:e2b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# TAVILY_API_KEY=
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
